@model List<mtkpm.Admin.Models.Notification.NotificationViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Notifications Management";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-bell"></i> Notifications Management</h1>
        <p class="text-muted">Send and manage system notifications</p>
    </div>
    <div class="page-header-actions">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#sendNotificationModal">
            <i class="fas fa-paper-plane"></i> Send New Notification
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="fas fa-filter"></i> Filters</h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search notifications..." 
                       value="@ViewBag.SearchTerm">
            </div>
            <div class="col-md-4">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Order" selected="@(ViewBag.SelectedType == "Order")">Order</option>
                    <option value="User" selected="@(ViewBag.SelectedType == "User")">User</option>
                    <option value="System" selected="@(ViewBag.SelectedType == "System")">System</option>
                    <option value="Alert" selected="@(ViewBag.SelectedType == "Alert")">Alert</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Notifications Table -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Notification History</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Sent Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var notification in Model)
                    {
                        <tr>
                            <td>
                                @switch (notification.Type)
                                {
                                    case "Order":
                                        <span class="badge bg-primary"><i class="fas fa-shopping-cart"></i> Order</span>
                                        break;
                                    case "User":
                                        <span class="badge bg-info"><i class="fas fa-user"></i> User</span>
                                        break;
                                    case "System":
                                        <span class="badge bg-secondary"><i class="fas fa-cog"></i> System</span>
                                        break;
                                    case "Alert":
                                        <span class="badge bg-danger"><i class="fas fa-exclamation"></i> Alert</span>
                                        break;
                                }
                            </td>
                            <td>
                                <strong>@notification.Title</strong>
                            </td>
                            <td>
                                @if (notification.IsRead)
                                {
                                    <span class="badge bg-success"><i class="fas fa-envelope-open"></i> Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning"><i class="fas fa-envelope"></i> Unread</span>
                                }
                            </td>
                            <td>@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/Notifications/Details/@notification.Id" class="btn btn-sm btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteNotification(@notification.Id)" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox" style="font-size: 2rem;"></i>
                            <p>No notifications found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Send Notification Modal -->
<div class="modal fade" id="sendNotificationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-paper-plane"></i> Send New Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="notificationForm" method="post" action="/Notifications/Send">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="recipientEmail" class="form-label">Recipient Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="recipientEmail" name="RecipientEmail" 
                               placeholder="Enter recipient email" required>
                    </div>

                    <div class="mb-3">
                        <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="title" name="Title" 
                               placeholder="Enter notification title" required>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Message <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="message" name="Message" rows="4" 
                                  placeholder="Enter notification message" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="notificationType" class="form-label">Notification Type</label>
                        <select class="form-select" id="notificationType" name="Type">
                            <option value="System">System</option>
                            <option value="Order">Order</option>
                            <option value="User">User</option>
                            <option value="Alert">Alert</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-send"></i> Send Notification
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Delete Notification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this notification?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteNotification(notificationId) {
            const deleteForm = document.getElementById('deleteForm');
            deleteForm.action = `/Notifications/Delete/${notificationId}`;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
