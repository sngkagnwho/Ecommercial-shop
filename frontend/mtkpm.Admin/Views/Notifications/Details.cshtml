@model mtkpm.Admin.Models.Notification.NotificationViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Notification Details";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-bell"></i> Notification Details</h1>
        <p class="text-muted">@Model.Title</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Notification Information</h6>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Type:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Type)
                        {
                            case "Order":
                                <span class="badge bg-primary">Order</span>
                                break;
                            case "User":
                                <span class="badge bg-info">User</span>
                                break;
                            case "System":
                                <span class="badge bg-secondary">System</span>
                                break;
                            case "Alert":
                                <span class="badge bg-danger">Alert</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                    <dt class="col-sm-4">Message:</dt>
                    <dd class="col-sm-8">@Model.Message</dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsRead)
                        {
                            <span class="badge bg-success">Read</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Unread</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Sent Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<a href="/Notifications" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left"></i> Back to Notifications
</a>
