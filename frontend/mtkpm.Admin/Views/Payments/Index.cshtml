@model List<mtkpm.Admin.Models.Payment.PaymentViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Payments Management";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-credit-card"></i> Payments Management</h1>
        <p class="text-muted">Track and manage payment transactions</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Payment Stats -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="metric-card primary">
            <h6>Total Transactions</h6>
            <h3>@ViewBag.TotalTransactions</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card success">
            <h6>Successful Payments</h6>
            <h3>${@ViewBag.TotalAmount.ToString("F2")}</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card warning">
            <h6>Pending Payments</h6>
            <h3>@ViewBag.PendingCount</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card danger">
            <h6>Failed Transactions</h6>
            <h3>@ViewBag.FailedCount</h3>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="fas fa-filter"></i> Filters</h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by transaction ID..." 
                       value="@ViewBag.SearchTerm">
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
                    <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending</option>
                    <option value="Failed" selected="@(ViewBag.SelectedStatus == "Failed")">Failed</option>
                    <option value="Refunded" selected="@(ViewBag.SelectedStatus == "Refunded")">Refunded</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="paymentMethod" class="form-select">
                    <option value="">All Methods</option>
                    <option value="CreditCard" selected="@(ViewBag.SelectedMethod == "CreditCard")">Credit Card</option>
                    <option value="Debit" selected="@(ViewBag.SelectedMethod == "Debit")">Debit Card</option>
                    <option value="PayPal" selected="@(ViewBag.SelectedMethod == "PayPal")">PayPal</option>
                    <option value="Transfer" selected="@(ViewBag.SelectedMethod == "Transfer")">Bank Transfer</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Payments Table -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Payment History</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>Order #</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-primary">@payment.TransactionId</strong>
                            </td>
                            <td>
                                <a href="/Orders/Details/@payment.OrderId" class="text-decoration-none">
                                    #@payment.OrderNumber
                                </a>
                            </td>
                            <td><strong class="text-success">${@payment.Amount.ToString("F2")}</strong></td>
                            <td>
                                <span class="badge bg-secondary">@payment.PaymentMethod</span>
                            </td>
                            <td>
                                @switch (payment.Status)
                                {
                                    case "Completed":
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Completed</span>
                                        break;
                                    case "Pending":
                                        <span class="badge bg-warning"><i class="fas fa-spinner"></i> Pending</span>
                                        break;
                                    case "Failed":
                                        <span class="badge bg-danger"><i class="fas fa-times"></i> Failed</span>
                                        break;
                                    case "Refunded":
                                        <span class="badge bg-info"><i class="fas fa-undo"></i> Refunded</span>
                                        break;
                                }
                            </td>
                            <td>@payment.OrderNumber</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/Payments/Details/@payment.Id" class="btn btn-sm btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (payment.Status == "Completed")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" onclick="refundPayment(@payment.Id)" title="Refund">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox" style="font-size: 2rem;"></i>
                            <p>No payments found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Refund Confirmation Modal -->
<div class="modal fade" id="refundModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-undo"></i> Refund Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to refund this payment? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="refundForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-info">Refund</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function refundPayment(paymentId) {
            const refundForm = document.getElementById('refundForm');
            refundForm.action = `/Payments/Refund/${paymentId}`;
            const modal = new bootstrap.Modal(document.getElementById('refundModal'));
            modal.show();
        }
    </script>
}
