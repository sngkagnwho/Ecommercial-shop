@model List<mtkpm.Admin.Models.Discount.DiscountViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Discounts Management";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-tag"></i> Discounts Management</h1>
        <p class="text-muted">Create and manage promotional discounts</p>
    </div>
    <div class="page-header-actions">
        <a href="/Discounts/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Discount
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="fas fa-filter"></i> Filters</h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by code..." 
                       value="@ViewBag.SearchTerm">
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(ViewBag.SelectedStatus == "Active")">Active</option>
                    <option value="Expired" selected="@(ViewBag.SelectedStatus == "Expired")">Expired</option>
                    <option value="Inactive" selected="@(ViewBag.SelectedStatus == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Discounts Table -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Discount List</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Value</th>
                    <th>Valid Period</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var discount in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-success">@discount.Code</strong>
                            </td>
                            <td>@discount.Description</td>
                            <td>
                                <strong>${@discount.Id.ToString()}</strong>
                            </td>
                            <td>
                                @discount.StartDate.ToString("MMM dd") - @discount.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (DateTime.Now < discount.EndDate && discount.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (DateTime.Now > discount.EndDate)
                                {
                                    <span class="badge bg-danger">Expired</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/Discounts/Details/@discount.Id" class="btn btn-sm btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/Discounts/Edit/@discount.Id" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteDiscount(@discount.Id)" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox" style="font-size: 2rem;"></i>
                            <p>No discounts found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Delete Discount</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this discount? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteDiscount(discountId) {
            const deleteForm = document.getElementById('deleteForm');
            deleteForm.action = `/Discounts/Delete/${discountId}`;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
