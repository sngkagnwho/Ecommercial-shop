@model mtkpm.Admin.Models.Discount.DiscountViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Discount Details";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-tag"></i> Discount Details</h1>
        <p class="text-muted">View discount information</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">@Model.Code</h6>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Discount ID</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @Model.Id
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Code</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        <code>@Model.Code</code>
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Description</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-secondary">No description</span>
                        }
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Discount Percent</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @Model.DiscountPercent%
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Discount Amount</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        $@Model.DiscountAmount
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Start Date</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @Model.StartDate.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">End Date</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @Model.EndDate.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Max Uses</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @(Model.MaxUses > 0 ? Model.MaxUses : "Unlimited")
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Status</h6>
                    </div>
                    <div class="col-sm-9">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success"><i class="fas fa-check"></i> Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="fas fa-times"></i> Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-sm-flex mt-3">
            <a href="/Discounts/Edit/@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="/Discounts" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
            <form method="post" action="/Discounts/Delete/@Model.Id" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this discount?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
</div>
