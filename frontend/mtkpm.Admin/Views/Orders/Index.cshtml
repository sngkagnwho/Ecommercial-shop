@model List<mtkpm.Admin.Models.Order.OrderViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Orders Management";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-shopping-cart"></i> Orders Management</h1>
        <p class="text-muted">Manage customer orders and track shipments</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="fas fa-filter"></i> Filters</h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by order number..." 
                       value="@ViewBag.SearchTerm">
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending</option>
                    <option value="Processing" selected="@(ViewBag.SelectedStatus == "Processing")">Processing</option>
                    <option value="Shipped" selected="@(ViewBag.SelectedStatus == "Shipped")">Shipped</option>
                    <option value="Delivered" selected="@(ViewBag.SelectedStatus == "Delivered")">Delivered</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Order List</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Order Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>
                                    <a href="/Orders/Details/@order.Id" class="text-decoration-none">
                                        #@order.OrderNumber
                                    </a>
                                </strong>
                            </td>
                            <td>
                                @order.UserEmail
                            </td>
                            <td>
                                <span class="badge bg-info">@order.OrderItems.Count items</span>
                            </td>
                            <td><strong class="text-success">${@order.TotalAmount.ToString("F2")}</strong></td>
                            <td>
                                @switch (order.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-secondary"><i class="fas fa-hourglass-start"></i> Pending</span>
                                        break;
                                    case "Processing":
                                        <span class="badge bg-warning"><i class="fas fa-spinner"></i> Processing</span>
                                        break;
                                    case "Shipped":
                                        <span class="badge bg-info"><i class="fas fa-truck"></i> Shipped</span>
                                        break;
                                    case "Delivered":
                                        <span class="badge bg-success"><i class="fas fa-check-circle"></i> Delivered</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="badge bg-warning">Unpaid</span>
                            </td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/Orders/Details/@order.Id" class="btn btn-sm btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-warning" onclick="editOrder(@order.Id)" title="Update Status">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox" style="font-size: 2rem;"></i>
                            <p>No orders found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function editOrder(orderId) {
            window.location.href = `/Orders/Edit/${orderId}`;
        }
    </script>
}
