@model mtkpm.Admin.Models.Order.OrderViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Order Details";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-receipt"></i> Order #@Model.OrderNumber</h1>
        <p class="text-muted">Order placed on @Model.OrderDate.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
    </div>
    <div class="page-header-actions">
        <a href="/Orders" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Orders
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Order Status & Information -->
    <div class="col-lg-8">
        <!-- Status Timeline -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-flag"></i> Order Status</h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3">
                        <div class="@(new[] {"Pending", "Processing", "Shipped", "Delivered"}.Contains(Model.Status) ? "text-success" : "text-muted")">
                            <i class="fas fa-check-circle" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">Pending</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="@(new[] {"Processing", "Shipped", "Delivered"}.Contains(Model.Status) ? "text-success" : "text-muted")">
                            <i class="fas fa-cog" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">Processing</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="@(new[] {"Shipped", "Delivered"}.Contains(Model.Status) ? "text-success" : "text-muted")">
                            <i class="fas fa-truck" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">Shipped</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="@(Model.Status == "Delivered" ? "text-success" : "text-muted")">
                            <i class="fas fa-box" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">Delivered</p>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <form method="post" action="/Orders/UpdateStatus/@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-8">
                                <select name="status" class="form-select">
                                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                                    <option value="Processing" selected="@(Model.Status == "Processing")">Processing</option>
                                    <option value="Shipped" selected="@(Model.Status == "Shipped")">Shipped</option>
                                    <option value="Delivered" selected="@(Model.Status == "Delivered")">Delivered</option>
                                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-save"></i> Update Status
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-list"></i> Order Items</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ProductName</strong><br>
                                    <small class="text-muted">Product ID: @item.ProductId</small>
                                </td>
                                <td>@item.Quantity</td>
                                <td>${@item.UnitPrice.ToString("F2")}</td>
                                <td><strong>${@(item.Quantity * item.UnitPrice).ToString("F2")}</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Shipping Address -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-map-marker-alt"></i> Shipping Address</h6>
            </div>
            <div class="card-body">
                <p>@Model.ShippingAddress</p>
            </div>
        </div>
    </div>

    <!-- Summary & Actions -->
    <div class="col-lg-4">
        <!-- Order Summary -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-calculator"></i> Order Summary</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <strong>${@Model.TotalAmount.ToString("F2")}</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 border-top pt-3">
                    <span class="h6 mb-0">Total Amount:</span>
                    <strong class="h6 mb-0 text-success">${@Model.TotalAmount.ToString("F2")}</strong>
                </div>
            </div>
        </div>

        <!-- Customer Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-user"></i> Customer Information</h6>
            </div>
            <div class="card-body">
                <p>
                    <strong>Email:</strong><br>
                    @Model.UserEmail
                </p>
                <p>
                    <strong>Payment Status:</strong><br>
                    <span class="badge bg-info">Pending</span>
                </p>
            </div>
        </div>

        <!-- Actions -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-cogs"></i> Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Orders" class="btn btn-secondary">
                        <i class="fas fa-list"></i> Back to Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
