@model mtkpm.Admin.Models.Category.CategoryViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Category Details";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-folder-open"></i> Category Details</h1>
        <p class="text-muted">View category information</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">@Model.Name</h6>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Category ID</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @Model.Id
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Category Name</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @Model.Name
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Description</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-secondary">No description</span>
                        }
                    </div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Products Count</h6>
                    </div>
                    <div class="col-sm-9 text-muted">
                        <span class="badge bg-info">@Model.ProductCount</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-sm-flex mt-3">
            <a href="/Categories/Edit/@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="/Categories" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
            <form method="post" action="/Categories/Delete/@Model.Id" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this category?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
</div>
