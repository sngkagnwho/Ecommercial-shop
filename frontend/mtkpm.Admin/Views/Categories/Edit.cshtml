@model mtkpm.Admin.Models.Category.UpdateCategoryViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Category";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-folder-edit"></i> Edit Category</h1>
        <p class="text-muted">Update category information</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Category Information</h6>
            </div>
            <div class="card-body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" action="/Categories/Edit/@Model.Id">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="Id" value="@Model.Id">

                    <div class="mb-3">
                        <label for="name" class="form-label">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="Name" value="@Model.Name" placeholder="Enter category name" required>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="4" 
                                  placeholder="Enter category description">@Model.Description</textarea>
                    </div>

                    <div class="d-grid gap-2 d-sm-flex">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Update Category
                        </button>
                        <a href="/Categories" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
