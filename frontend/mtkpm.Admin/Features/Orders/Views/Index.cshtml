@model List<mtkpm.Admin.Features.Orders.Models.OrderViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Orders Management";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-shopping-cart"></i> Orders Management</h1>
        <p class="text-muted">Manage customer orders</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Orders Table -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Order List</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@order.Id</span></td>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.UserName</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><strong class="text-success">${@order.TotalAmount.ToString("F2")}</strong></td>
                            <td>
                                @{
                                    var statusClass = order.Status switch
                                    {
                                        1 => "warning",      // Pending
                                        2 => "info",         // Confirmed
                                        3 => "primary",      // Processing
                                        4 => "secondary",    // Shipping
                                        5 => "success",      // Delivered
                                        6 => "success",      // Completed
                                        7 => "danger",       // Cancelled
                                        8 => "warning",      // Returned
                                        9 => "danger",       // Failed
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@statusClass">@order.StatusDisplay</span>
                            </td>
                            <td>
                                @if (order.IsPaid)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check"></i> Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning"><i class="fas fa-clock"></i> Pending</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/Orders/Details/@order.Id" class="btn btn-sm btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/Orders/UpdateStatus/@order.Id" class="btn btn-sm btn-warning" title="Update Status">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox" style="font-size: 2rem;"></i>
                            <p>No orders found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.Pagination != null && ViewBag.Pagination.TotalPages > 1)
    {
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <div class="text-muted">
                Page <strong>@ViewBag.Pagination.CurrentPage</strong> of <strong>@ViewBag.Pagination.TotalPages</strong>
                (<strong>@ViewBag.Pagination.TotalItems</strong> total items)
            </div>
            <nav>
                <ul class="pagination mb-0">
                    @if (ViewBag.Pagination.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?pageIndex=@(ViewBag.Pagination.CurrentPage - 1)">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-chevron-left"></i> Previous</span>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.Pagination.TotalPages; i++)
                    {
                        @if (i == ViewBag.Pagination.CurrentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else if (i <= ViewBag.Pagination.CurrentPage + 2 && i >= ViewBag.Pagination.CurrentPage - 2)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?pageIndex=@i">@i</a>
                            </li>
                        }
                    }

                    @if (ViewBag.Pagination.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?pageIndex=@(ViewBag.Pagination.CurrentPage + 1)">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Next <i class="fas fa-chevron-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
