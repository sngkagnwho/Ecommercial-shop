@model mtkpm.Admin.Features.Orders.Models.OrderViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Order Details";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-receipt"></i> Order Details</h1>
        <p class="text-muted">Order #@Model.OrderNumber</p>
    </div>
    <div>
        <a href="/Orders/Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Order Header -->
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Order Information</h6>
                <div>
                    @{
                        var statusClass = Model.Status switch
                        {
                            1 => "warning",      // Pending
                            2 => "info",         // Confirmed
                            3 => "primary",      // Processing
                            4 => "secondary",    // Shipping
                            5 => "success",      // Delivered
                            6 => "success",      // Completed
                            7 => "danger",       // Cancelled
                            8 => "warning",      // Returned
                            9 => "danger",       // Failed
                            _ => "secondary"
                        };
                    }
                    <span class="badge bg-@statusClass" style="font-size: 1rem;">@Model.StatusDisplay</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted">Order Number</label>
                        <p class="fw-bold">@Model.OrderNumber</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted">Order Date</label>
                        <p class="fw-bold">@Model.OrderDate.ToString("MMMM dd, yyyy HH:mm:ss")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted">Customer</label>
                        <p class="fw-bold">@Model.UserName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted">Payment Status</label>
                        <p class="fw-bold">
                            @if (Model.IsPaid)
                            {
                                <span class="badge bg-success"><i class="fas fa-check"></i> Paid</span>
                                <small class="text-muted">@Model.PaidAt?.ToString("MMMM dd, yyyy HH:mm:ss")</small>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="fas fa-clock"></i> Pending</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label class="text-muted">Payment Method</label>
                        <p class="fw-bold">@Model.PaymentMethodDisplay</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-list"></i> Order Items</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderItems != null && Model.OrderItems.Count > 0)
                        {
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <p class="fw-bold mb-1">@item.ProductName</p>
                                            <small class="text-muted">Product ID: @item.ProductId</small>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">${@item.PriceAtOrder.ToString("F2")}</td>
                                    <td class="text-end fw-bold">${@item.TotalPrice.ToString("F2")}</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">
                                    No items in this order
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Order Note -->
        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-sticky-note"></i> Order Note</h6>
                </div>
                <div class="card-body">
                    <p>@Model.Note</p>
                </div>
            </div>
        }
    </div>

    <!-- Order Summary & Addresses -->
    <div class="col-lg-4">
        <!-- Order Summary -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">Order Summary</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <span>${@Model.SubTotal.ToString("F2")}</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Shipping Fee:</span>
                    <span>${@Model.ShippingFee.ToString("F2")}</span>
                </div>
                @if (Model.Discount > 0)
                {
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-success">Discount:</span>
                        <span class="text-success">-${@Model.Discount.ToString("F2")}</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between fw-bold" style="font-size: 1.1rem;">
                    <span>Total Amount:</span>
                    <span class="text-success">${@Model.TotalAmount.ToString("F2")}</span>
                </div>
            </div>
        </div>

        <!-- Shipping Address -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-map-marker-alt"></i> Shipping Address</h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                {
                    <p class="mb-0">@Model.ShippingAddress</p>
                }
                else
                {
                    <p class="text-muted mb-0">No shipping address provided</p>
                }
            </div>
        </div>

        <!-- Billing Address -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-home"></i> Billing Address</h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.BillingAddress))
                {
                    <p class="mb-0">@Model.BillingAddress</p>
                }
                else
                {
                    <p class="text-muted mb-0">No billing address provided</p>
                }
            </div>
        </div>

        <!-- Saved Addresses Reference -->
        @if (ViewBag.UserAddresses != null && ((List<mtkpm.Admin.Features.Orders.Models.UserAddressViewModel>)ViewBag.UserAddresses).Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-bookmark"></i> Your Saved Addresses</h6>
                    <a href="/Orders/Addresses" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-cog"></i> Manage
                    </a>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @foreach (var addr in (List<mtkpm.Admin.Features.Orders.Models.UserAddressViewModel>)ViewBag.UserAddresses)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">
                                            @addr.Label
                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge bg-success ms-2"><i class="fas fa-star"></i> Default</span>
                                            }
                                        </h6>
                                        <p class="mb-0 text-muted small">
                                            @addr.ReceiverName | @addr.PhoneNumber
                                        </p>
                                        <p class="mb-0 text-muted small">
                                            @addr.Street, @addr.Ward, @addr.District, @addr.City
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Actions -->
        <div>
            <a href="/Orders/UpdateStatus/@Model.Id" class="btn btn-warning w-100 mb-2">
                <i class="fas fa-edit"></i> Update Status
            </a>
            <a href="/Orders/Index" class="btn btn-secondary w-100">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
