@model List<mtkpm.Admin.Models.User.UserViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Users Management";
}

<div class="page-header mb-4">
    <div>
        <h1><i class="fas fa-users"></i> Users Management</h1>
        <p class="text-muted">Manage user accounts and permissions</p>
    </div>
    <div class="page-header-actions">
        <a href="/UserProfile" class="btn btn-info">
            <i class="fas fa-user-circle"></i> My Profile
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Dashboard Statistics -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Total Users</h5>
                <h2 class="card-text">@((ViewBag.Statistics as mtkpm.Admin.Models.User.UserStatisticsViewModel)?.TotalUsers ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Active</h5>
                <h2 class="card-text text-success">@((ViewBag.Statistics as mtkpm.Admin.Models.User.UserStatisticsViewModel)?.ActiveUsersThisMonth ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Locked</h5>
                <h2 class="card-text text-warning">@((ViewBag.Statistics as mtkpm.Admin.Models.User.UserStatisticsViewModel)?.LockedUsers ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">New This Month</h5>
                <h2 class="card-text text-info">@((ViewBag.Statistics as mtkpm.Admin.Models.User.UserStatisticsViewModel)?.NewUsersThisMonth ?? 0)</h2>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="fas fa-search"></i> Search Users</h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-8">
                <input type="text" name="searchTerm" class="form-control" 
                       placeholder="Search by username, email, or phone..." 
                       value="@ViewBag.SearchTerm">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="fas fa-list"></i> Users List</h6>
        <small class="text-muted">Total: @(Model?.Count ?? 0) users</small>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="width: 200px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@user.Id</span>
                            </td>
                            <td>
                                <strong>@user.Username</strong>
                            </td>
                            <td>
                                @user.Email
                                @if (user.EmailConfirmed)
                                {
                                    <i class="fas fa-check-circle text-success ms-1" title="Verified"></i>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(user.PhoneNumber) ? "-" : user.PhoneNumber)
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-times"></i> Inactive</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <!-- View Button -->
                                    <a href="/Users/Details/@user.Id" class="btn btn-info" title="View details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    
                                    <!-- Edit Button -->
                                    <a href="/Users/Edit/@user.Id" class="btn btn-warning" title="Edit user">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    
                                    <!-- Role Button -->
                                    <button type="button" class="btn btn-secondary" data-bs-toggle="modal" 
                                            data-bs-target="#roleModal" onclick="setRoleModalData('@user.Id', '@user.Username');"
                                            title="Change user role">
                                        <i class="fas fa-shield-alt"></i>
                                    </button>
                                    
                                    <!-- Lock Button -->
                                    <button type="button" class="btn btn-info" data-bs-toggle="modal" 
                                            data-bs-target="#lockModal" onclick="setLockModalData('@user.Id', '@user.Username', @user.IsLocked.ToString().ToLower());"
                                            title="Lock/unlock account">
                                        <i class="fas fa-lock"></i>
                                    </button>
                                    
                                    <!-- Delete Button -->
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" 
                                            data-bs-target="#deleteModal" onclick="setDeleteModalData(@user.Id, '@user.Username');"
                                            title="Delete user">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted">
                                <i class="fas fa-inbox" style="font-size: 2rem; display: block; margin-bottom: 1rem;"></i>
                                <p>No users found</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-trash"></i> Delete User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="deleteForm" method="post" action="/Users/Delete">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle"></i> <strong>You are about to delete this user!</strong>
                    </div>
                    <p>Are you sure you want to delete: <strong id="deleteUserName"></strong>?</p>
                    <p class="text-muted small">This action cannot be undone.</p>
                    <input type="hidden" id="deleteUserId" name="id">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title"><i class="fas fa-shield-alt"></i> Change User Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="roleForm" method="post" action="/Users/UpdateRole">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>Change role for: <strong id="roleUserName"></strong></p>
                    <div class="mb-3">
                        <label for="roleSelect" class="form-label">Select New Role</label>
                        <select id="roleSelect" name="roleName" class="form-select" required>
                            <option value="">-- Choose Role --</option>
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                            <option value="Moderator">Moderator</option>
                        </select>
                    </div>
                    <input type="hidden" id="roleUserId" name="userId">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Lock Modal -->
<div class="modal fade" id="lockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-lock"></i> Lock/Unlock Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="lockForm" method="post" action="/Users/LockUser">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p id="lockMessage">Change lock status for: <strong id="lockUserName"></strong></p>
                    <div class="mb-3">
                        <label for="lockSelect" class="form-label">Account Status</label>
                        <select id="lockSelect" name="isLocked" class="form-select" required>
                            <option value="">-- Choose Action --</option>
                            <option value="true">Lock Account</option>
                            <option value="false">Unlock Account</option>
                        </select>
                    </div>
                    <input type="hidden" id="lockUserId" name="userId">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .page-header h1 {
        margin-bottom: 0;
        font-weight: 600;
    }

    .page-header-actions {
        display: flex;
        gap: 0.5rem;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border-radius: 0.5rem;
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }
</style>

<script>
    function setDeleteModalData(userId, username) {
        document.getElementById('deleteUserId').value = userId;
        document.getElementById('deleteUserName').innerText = username;
    }

    function setRoleModalData(userId, username) {
        document.getElementById('roleUserId').value = userId;
        document.getElementById('roleUserName').innerText = username;
        document.getElementById('roleSelect').value = '';
    }

    function setLockModalData(userId, username, isLocked) {
        document.getElementById('lockUserId').value = userId;
        document.getElementById('lockUserName').innerText = username;
        document.getElementById('lockSelect').value = '';
    }
</script>

<script>
    function setDeleteModalData(userId, username) {
        document.getElementById('deleteUserId').value = userId;
        document.getElementById('deleteUserName').textContent = username;
    }
</script>

