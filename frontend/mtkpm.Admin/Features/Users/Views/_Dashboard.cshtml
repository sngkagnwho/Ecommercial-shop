@model mtkpm.Admin.Models.User.UserStatisticsViewModel

@{
    var stats = Model ?? new mtkpm.Admin.Models.User.UserStatisticsViewModel();
}

<div class="row">
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Total Users</h6>
                        <h3 class="mb-0 mt-2">@stats.TotalUsers</h3>
                    </div>
                    <i class="fas fa-users fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Active This Month</h6>
                        <h3 class="mb-0 mt-2">@stats.ActiveUsersThisMonth</h3>
                    </div>
                    <i class="fas fa-user-check fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-warning text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Locked Accounts</h6>
                        <h3 class="mb-0 mt-2">@stats.LockedUsers</h3>
                    </div>
                    <i class="fas fa-lock fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">New This Month</h6>
                        <h3 class="mb-0 mt-2">@stats.NewUsersThisMonth</h3>
                    </div>
                    <i class="fas fa-user-plus fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>
