@model List<mtkpm.Admin.Models.Category.CategoryViewModel>

@{
    ViewData["Title"] = "Categories Management";
    Layout = "_Layout";
}

<div class="page-header mb-4">
    <hgroup>
        <h1><i class="fas fa-list"></i> Categories Management</h1>
        <p class="text-muted">Quản lý danh mục sản phẩm của bạn</p>
    </hgroup>
    <a href="/Categories/Create" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Add Category
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-table"></i> Danh sách Categories (@Model.Count())</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th style="width: 100px;">Sản phẩm</th>
                        <th style="width: 150px;">Ngày tạo</th>
                        <th style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary">@category.Id</span>
                            </td>
                            <td>
                                <strong>@category.Name</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(category.Description))
                                {
                                    <span class="text-muted">@(category.Description.Length > 50 ? category.Description.Substring(0, 50) + "..." : category.Description)</span>
                                }
                                else
                                {
                                    <span class="text-muted"><em>Không có mô tả</em></span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info">@category.ProductCount</span>
                            </td>
                            <td>
                                <small class="text-muted">@category.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="/Categories/Details/@category.Id" class="btn btn-sm btn-outline-info" title="View">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="/Categories/Edit/@category.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" onclick="setDeleteId(@category.Id, '@category.Name')" title="Delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        <div>
            <strong>Không có danh mục nào!</strong><br>
            <small>Hãy <a href="/Categories/Create" class="alert-link">tạo danh mục đầu tiên</a> để bắt đầu.</small>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn chắc chắn muốn xóa danh mục: <strong id="categoryName"></strong>?</p>
                <div class="alert alert-warning" role="alert">
                    <small><i class="fas fa-warning"></i> Hành động này không thể hoàn tác!</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #dee2e6;
    }

    .page-header hgroup {
        flex: 1;
    }

    .page-header h1 {
        margin: 0;
        font-size: 2rem;
        color: #333;
    }

    .page-header .text-muted {
        margin: 0.5rem 0 0 0;
        font-size: 0.95rem;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn-group {
        display: flex;
        gap: 0.25rem;
    }

    .modal-content {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .modal-header {
        border: none;
    }

    .modal-body {
        padding: 1.5rem;
    }
</style>

<script>
    function setDeleteId(id, name) {
        document.getElementById('categoryName').textContent = name;
        document.getElementById('deleteForm').action = '/Categories/Delete/' + id;
    }
</script>
