@model mtkpm.Admin.Models.Product.CreateProductViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Add New Product";
}

<div class="page-header">
    <h1><i class="fas fa-plus"></i> Add New Product</h1>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <h6><i class="fas fa-exclamation-circle"></i> Please correct the errors below</h6>
        <ul class="mb-0">
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                @foreach (var error in modelState.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" class="row">
    @Html.AntiForgeryToken()
    
    <div class="col-lg-8">
        <!-- Basic Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-info-circle"></i> Basic Information</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="Name" class="form-label">Product Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" 
                           id="Name" name="Name" value="@Model.Name" placeholder="Enter product name" required>
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                    <textarea class="form-control" 
                              id="Description" name="Description" rows="4" 
                              placeholder="Enter detailed product description" required>@Model.Description</textarea>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="Price" class="form-label">Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" 
                                       id="Price" name="Price" value="@Model.Price" 
                                       placeholder="0.00" step="0.01" min="0" required>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="CategoryId" class="form-label">Category <span class="text-danger">*</span></label>
                            <select class="form-select" 
                                    id="CategoryId" name="CategoryId" required>
                                <option value="">Select a category</option>
                                @if (ViewBag.Categories != null)
                                {
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">
                                            @category.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-cubes"></i> Inventory</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="StockQuantity" class="form-label">Stock Quantity <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" 
                           id="StockQuantity" name="StockQuantity" value="@Model.StockQuantity" 
                           placeholder="0" min="0" required>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Image -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-image"></i> Product Image</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="ImageUrl" class="form-label">Image URL (Optional)</label>
                    <input type="url" class="form-control" id="ImageUrl" name="ImageUrl" 
                           value="@Model.ImageUrl" placeholder="https://example.com/image.jpg">
                    <small class="text-muted">Enter a valid HTTP(S) URL to an image</small>
                </div>
            </div>
        </div>
        </div>

        <!-- Action Buttons -->
        <div class="card">
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save"></i> Create Product
                    </button>
                    <a href="/Products" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Validate ImageUrl field when form submits
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const imageUrlField = document.getElementById('ImageUrl');
                    if (imageUrlField && imageUrlField.value) {
                        // Only allow valid http(s) URLs
                        if (!imageUrlField.value.startsWith('http://') && !imageUrlField.value.startsWith('https://')) {
                            e.preventDefault();
                            imageUrlField.value = '';
                            imageUrlField.placeholder = 'Please enter a valid URL starting with http:// or https://';
                            imageUrlField.classList.add('is-invalid');
                            return false;
                        }
                    }
                });
            }
        });
    </script>
}
