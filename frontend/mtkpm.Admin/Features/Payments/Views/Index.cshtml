@model List<mtkpm.Admin.Models.Payment.PaymentMethodViewModel>

@{
    ViewData["Title"] = "Payment Methods Management";
}

<div class="page-header mb-4">
    <div>
        <h1><i class="fas fa-credit-card"></i> Payment Methods</h1>
        <p class="text-muted">Manage payment method configurations</p>
    </div>
    <div class="page-header-actions">
        <a href="/Payments/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Payment Method
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    @{
        var stats = (ViewBag.Statistics as mtkpm.Admin.Models.Payment.PaymentStatisticsViewModel) ?? new mtkpm.Admin.Models.Payment.PaymentStatisticsViewModel();
    }
    
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-primary mb-2">@stats.TotalMethods</h2>
                <p class="text-muted mb-0">Total Methods</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-success mb-2">@stats.ActiveMethods</h2>
                <p class="text-muted mb-0">Active</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-warning mb-2">@stats.InactiveMethods</h2>
                <p class="text-muted mb-0">Inactive</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-info mb-2">@stats.AverageFeePercentage.ToString("F1")%</h2>
                <p class="text-muted mb-0">Avg Fee</p>
            </div>
        </div>
    </div>
</div>

<!-- Search Form -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/Payments" class="row g-3">
            <div class="col-md-8">
                <input type="text" class="form-control" name="searchTerm" placeholder="Search by name, code..." 
                       value="@(ViewBag.SearchTerm ?? "")">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Payment Methods Table -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-list"></i> Payment Methods</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 10%">Code</th>
                    <th style="width: 15%">Name</th>
                    <th style="width: 10%">Status</th>
                    <th style="width: 12%">Fee</th>
                    <th style="width: 18%">Amount Limits</th>
                    <th style="width: 15%">Processing</th>
                    <th style="width: 20%">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Count > 0)
                {
                    @foreach (var method in Model.OrderBy(m => m.DisplayOrder))
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@method.Code</span>
                            </td>
                            <td>
                                <strong>@method.Name</strong>
                                @if (!string.IsNullOrEmpty(method.Icon))
                                {
                                    <span class="ms-2">@method.Icon</span>
                                }
                            </td>
                            <td>
                                @if (method.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-times"></i> Inactive</span>
                                }
                            </td>
                            <td>
                                <small>
                                    @if (method.IsHighFee)
                                    {
                                        <span class="badge bg-warning">HIGH</span>
                                    }
                                    @method.FeeSummary
                                </small>
                            </td>
                            <td>
                                <small>@method.AmountRange</small>
                            </td>
                            <td>
                                <small>@method.ProcessingTime</small>
                            </td>
                            <td>
                                <a href="/Payments/Details/@method.Id" class="btn btn-sm btn-info" title="View">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <a href="/Payments/Edit/@method.Id" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form method="post" action="/Payments/ToggleStatus/@method.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="isActive" value="@(!method.IsActive)"/>
                                    <button type="submit" class="btn btn-sm btn-secondary" title="@(method.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fas fa-@(method.IsActive ? "pause" : "play")"></i>
                                    </button>
                                </form>
                                <form method="post" action="/Payments/Delete/@method.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this payment method?');" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox"></i> No payment methods found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .page-header h1 {
        margin-bottom: 0;
        font-weight: 600;
    }

    .page-header-actions {
        display: flex;
        gap: 0.5rem;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border-radius: 0.5rem;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
