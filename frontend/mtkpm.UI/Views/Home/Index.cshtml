</section>


<script>
 async function navigateTo(pageId, params = null) {
    console.log("Điều hướng tới:", pageId);

    // 1. Ẩn tất cả các trang và gỡ class active
    const pages = document.querySelectorAll('.page');
    pages.forEach(p => {
        p.style.display = 'none'; // Ép ẩn bằng style inline
        p.classList.remove('active');
    });

    // 2. Hiện trang đích
    const target = document.getElementById(`page-${pageId}`);
    if (target) {
        target.style.display = 'block'; // Ép hiện bằng style inline
        target.classList.add('active');
    } else {
        console.error("Không tìm thấy trang: page-" + pageId);
        return;
    }

    // 3. Xử lý Logic đổ dữ liệu cho từng trang
    try {
        switch (pageId) {
            case 'home':
                await renderHome(); // Hàm của mày là renderHome chứ ko phải renderHomePage
                break;
            case 'category':
                if (params) await navigateToCategory(params);
                break;
            case 'detail':
                if (params) await navigateToDetail(params);
                break;
            case 'cart':
                await loadCart();
                break;
            case 'favourites':
                await renderFavouritesPage(); // Đổ API vào khung tĩnh
                break;
            case 'orders':
                await loadMyOrders();
                break;
            case 'profile':
                await loadProfilePage();
                break;
        }
    } catch (err) {
        console.error("Lỗi khi render trang:", err);
    }

    window.scrollTo(0, 0);
}

async function renderFavouritesPage() {
    // Tìm đúng các ID trong cái HTML tĩnh mày gửi
    const grid = document.getElementById('fav-grid-static');
    const emptyMsg = document.getElementById('fav-empty-static');
    const countInfo = document.getElementById('fav-count-info');

    if (!grid) return;

    // Hiện loading trong grid
    grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 50px;">ĐANG TẢI...</div>';
    if (emptyMsg) emptyMsg.style.display = 'none';

    try {
        // 1. Đồng bộ sản phẩm và danh sách yêu thích
        if (!state.products || state.products.length === 0) {
            const res = await apiFetch('/api/products/all'); // Dùng đúng endpoint của mày
            state.products = res.data?.items || res.data || [];
        }
        await loadFavourites();

        // 2. Lọc sản phẩm
        const favItems = state.products.filter(p => 
            state.favourites.some(favId => Number(favId) === Number(p.id))
        );

        // 3. Hiển thị
        if (favItems.length === 0) {
            grid.innerHTML = '';
            if (emptyMsg) emptyMsg.style.display = 'block';
            if (countInfo) countInfo.innerText = "0 SẢN PHẨM";
            return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';
        if (countInfo) countInfo.innerText = `${favItems.length} SẢN PHẨM`;

        grid.innerHTML = favItems.map(p => `
            <div class="product-card" onclick="navigateTo('detail', ${p.id})">
                <div class="img-wrap">
                    <img src="${imgSrc(p.imageUrl)}" onerror="this.src='https://cdn-icons-png.flaticon.com/512/679/679821.png'">
                    <div class="fav-icon-active" 
                         onclick="event.stopPropagation(); handleRemoveFav(${p.id})" 
                         style="position:absolute; top:10px; right:10px; color:red; font-size:24px; cursor:pointer;">❤</div>
                </div>
                <div class="p-info">
                    <div class="p-name" style="font-weight:700;">${p.name}</div>
                    <div class="p-price">${fmtVND(p.price)}</div>
                    <button class="btn-adi btn-white" style="width:100%; margin-top:10px;" 
                            onclick="event.stopPropagation(); addToCart(${p.id})">THÊM VÀO GIỎ</button>
                </div>
            </div>
        `).join('');

    } catch (err) {
        grid.innerHTML = '<p style="grid-column:1/-1; text-align:center;">Không thể tải danh sách.</p>';
    }
}

 async function handleRemoveFav(pid) {
    if(!confirm("Bạn có muốn xóa sản phẩm này khỏi danh sách yêu thích?")) return;
    
    // Tạm gán để hàm toggle của bạn biết xóa cái nào
    const backup = state.currentProduct;
    state.currentProduct = state.products.find(p => p.id === pid) || { id: pid };
    
    try {
        await toggleFavourite(); // Gọi API DELETE
        await renderFavouritesPage(); // Vẽ lại trang ngay lập tức
    } catch (err) {
        console.error("Lỗi xóa:", err);
    } finally {
        state.currentProduct = backup;
        updateFavBadge(); // Cập nhật số trên Header
    }
}

  // ============ CONFIGURATION ============
  const API_BASE_URL = "https://localhost:5107";

  // ============ STATE ============
  let state = {
    user: JSON.parse(localStorage.getItem('user')) || null,
    token: localStorage.getItem('token') || null,
    categories: [],
    products: [],
    currentCategoryProducts: [],
    currentCategoryId: null,
    apiCart: null,
    cartSummary: { subtotal: 0, discount: 0, finalTotal: 0, discountCodes: [] },
    currentProduct: null,
    favourites: []
  };

  // ============ API HELPERS ============
  async function apiFetch(endpoint, options = {}) {
    const url = endpoint.startsWith('http') ? endpoint : `${API_BASE_URL}${endpoint}`;
    const defaultHeaders = {
      'Content-Type': 'application/json',
      ...(state.token ? { 'Authorization': `Bearer ${state.token}` } : {})
    };
    try {
      const response = await fetch(url, { ...options, headers: { ...defaultHeaders, ...options.headers } });
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || 'Có lỗi xảy ra');
      return result;
    } catch (err) {
      showToast(err.message, 'error');
      throw err;
    }
  }

  async function apiFetchAuth(endpoint, options = {}) {
    let token = localStorage.getItem('token');
    const url = endpoint.startsWith('http') ? endpoint : `${API_BASE_URL}${endpoint}`;
    const defaultHeaders = {
      'Content-Type': 'application/json',
      ...(token ? { 'Authorization': `Bearer ${token}` } : {})
    };
    let response = await fetch(url, { ...options, headers: { ...defaultHeaders, ...options.headers } });
    if (response.status === 401) {
      try {
        const rt = localStorage.getItem('refreshToken');
        if (rt) {
          const refreshRes = await fetch(`${API_BASE_URL}/api/auth/refresh-token`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ accessToken: token, refreshToken: rt })
          });
          const refreshData = await refreshRes.json();
          if (refreshData.success && refreshData.data) {
            token = refreshData.data.accessToken;
            localStorage.setItem('token', token);
            localStorage.setItem('refreshToken', refreshData.data.refreshToken);
            state.token = token;
            response = await fetch(url, {
              ...options,
              headers: { ...defaultHeaders, 'Authorization': `Bearer ${token}`, ...options.headers }
            });
          }
        }
      } catch { /* refresh failed */ }
    }
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(result.message || `HTTP ${response.status}`);
    return result;
  }

  // ============ UTILS ============
  function fmtVND(n) {
    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n || 0);
  }

  function imgSrc(url) {
    if (!url || url === "noimage" || url === "string") {
        return 'https://cdn-icons-png.flaticon.com/512/679/679821.png';
    }
    // Nếu là link ảnh từ Adidas hoặc mạng (http/https)
    if (url.startsWith('http')) return url;

    // Nếu là link tương đối từ server nội bộ
    const base = API_BASE_URL.endsWith('/') ? API_BASE_URL : API_BASE_URL + '/';
    const path = url.startsWith('/') ? url.substring(1) : url;
    return base + path;
}

  function showToast(msg, type = 'success') {
    const container = document.getElementById('toast-container');
    const t = document.createElement('div');
    t.className = `toast ${type}`;
    t.innerText = msg;
    container.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 500); }, 2500);
  }

  function requireAuth(action) {
    if (!localStorage.getItem('token')) {
      showToast('Vui lòng đăng nhập để ' + action, 'error');
      window.location.href = '/Auth';
      return false;
    }
    return true;
  }

  function logout() {
    state.user = null;
    state.token = null;
    localStorage.clear();
    location.reload();
  }

  // ============ NAVBAR ============
  function renderNavbar() {
    const container = document.getElementById('nav-actions');
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || 'null');

    // 1. Nếu đã đăng nhập
    if (token && user) {
        container.innerHTML = `
            <button class="nav-btn ghost" onclick="navigateTo('cart')" title="Giỏ hàng">
                🛒 <span class="cart-badge" id="nav-cart-badge">0</span>
            </button>
            <button class="nav-btn ghost" onclick="navigateTo('orders')" title="Đơn hàng">📋</button>
            <button class="nav-btn ghost" onclick="navigateTo('profile')">
                👤 ${user.userName || user.name || 'Tài khoản'}
            </button>
            <button class="nav-btn accent" onclick="logout()">Thoát</button>
        `;
        
        // Cập nhật số lượng giỏ hàng và yêu thích ngay khi load Navbar
        refreshCartCount(); 
        if (typeof updateFavBadge === 'function') updateFavBadge(); 

    } else {
        // 2. Nếu chưa đăng nhập
        container.innerHTML = `
            <button class="nav-btn ghost" onclick="navigateTo('cart')">
                🛒 <span class="cart-badge">0</span>
            </button>
            <button class="nav-btn accent" onclick="window.location.href='/Auth'">Đăng nhập</button>
        `;
    }
}
  // ============ INIT ============
  async function init() {
    renderNavbar();
    await loadCategories();
    renderSidebar();
    await renderHome();
  }

  async function loadCategories() {
    try {
      const res = await apiFetch('/api/categories');
      state.categories = Array.isArray(res.data) ? res.data : (res.data.items || []);
    } catch (e) {
      console.error("Lỗi tải danh mục");
      state.categories = [];
    }
  }

  function renderSidebar() {
    const sidebar = document.getElementById('side-categories');
    if (!sidebar) return;
    sidebar.innerHTML = state.categories.map(c =>
        `<div class="sidebar-cat-item" onclick="navigateToCategory(${c.id})">${c.name}</div>`
    ).join('');
  }

  async function renderHome() {
    const catContainer  = document.getElementById('home-categories');
    const prodContainer = document.getElementById('home-products');
    const loading       = document.getElementById('home-products-loading');
    
    catContainer.innerHTML = state.categories.length > 0
      ? state.categories.map(c => `<div class="sidebar-cat-item" onclick="navigateToCategory(${c.id})"><div class="name">${c.name}</div></div>`).join('')
      : '<p>Đang cập nhật danh mục...</p>';
      
    if (loading) loading.style.display = 'flex';
    try {
      const res = await apiFetch('/api/products/all');
      let rawData = res.data?.items || res.data || [];
      state.products = Array.isArray(rawData) ? rawData : [];
      prodContainer.innerHTML = state.products.length > 0
        ? state.products.slice(0, 8).map(p => renderProductCard(p)).join('')
        : '<p style="grid-column:1/-1; text-align:center;">Không có sản phẩm nào.</p>';
    } catch {
      prodContainer.innerHTML = '<p style="grid-column:1/-1; text-align:center; color:red;">Lỗi tải sản phẩm.</p>';
    } finally {
      if (loading) loading.style.display = 'none';
    }
  }

  function renderProductCard(p) {
    const src = p.imageUrl ? (p.imageUrl.startsWith('http') ? p.imageUrl : `${API_BASE_URL}${p.imageUrl}`) : 'noimage';
    return `
      <div class="product-card" onclick="navigateToDetail(${p.id})">
        <div class="img-wrap">
          <img src="${src}" alt="${p.name}" onerror="this.src='https://cdn-icons-png.flaticon.com/512/679/679821.png'">
        </div>
        <div class="p-info">
          <div class="p-cat">${p.categoryName || 'Sản phẩm'}</div>
          <div class="p-name" title="${p.name}">${p.name}</div>
          <div class="p-price">${fmtVND(p.price)}</div>
          <div class="p-stock">Còn lại: <strong>${p.stockQuantity || 0}</strong></div>
          <div class="p-actions">
            <button class="btn-adi btn-white" style="width:100%; height:40px; font-size:11px;" onclick="event.stopPropagation(); addToCart(${p.id})">THÊM VÀO GIỎ</button>
          </div>
        </div>
      </div>`;
  }

  function sortProducts(sortType) {
    const container = document.getElementById('cat-products');
    if (!state.currentCategoryProducts || state.currentCategoryProducts.length === 0) return;
    let sorted = [...state.currentCategoryProducts];
    if (sortType === 'price-asc')  sorted.sort((a, b) => a.price - b.price);
    else if (sortType === 'price-desc') sorted.sort((a, b) => b.price - a.price);
    else sorted.sort((a, b) => b.id - a.id);
    container.innerHTML = sorted.map(p => renderProductCard(p)).join('');
  }

  async function navigateToCategory(catId) {
    await navigateTo('category');
    state.currentCategoryId = catId;
    const cat = state.categories.find(c => c.id == catId);
    document.getElementById('cat-title').innerText = cat ? cat.name : 'Danh mục';
    const container = document.getElementById('cat-products');
    container.innerHTML = '<div class="loading-overlay" style="display:flex;"><div class="spinner"></div></div>';
    try {
      const res = await apiFetch(`/api/products?pageIndex=1&pageSize=50&categoryId=${catId}`);
      const prods = Array.isArray(res.data) ? res.data : (res.data.items || []);
      state.currentCategoryProducts = prods;
      document.getElementById('cat-count').innerText = `Tìm thấy ${prods.length} sản phẩm`;
      sortProducts(document.querySelector('.products-sort select').value);
    } catch {
      container.innerHTML = 'Lỗi tải sản phẩm.';
    }
  }

  function handleBreadcrumbCategory() {
    if (state.currentCategoryId) navigateToCategory(state.currentCategoryId);
    else navigateTo('home');
  }

  async function addToCart(id) {
    if (requireAuth('thêm vào giỏ hàng')) {
      try {
        await apiFetchAuth('/api/cart', { method: 'POST', body: JSON.stringify({ productId: id, quantity: 1 }) });
        showToast('Đã thêm vào giỏ hàng ✓', 'success');
        refreshCartCount();
      } catch (err) { showToast(err.message, 'error'); }
    }
  }

  // ════════════════════════════════════════════════════════
  //  PRODUCT DETAIL
  // ════════════════════════════════════════════════════════
async function navigateToDetail(id) {
    // QUAN TRỌNG: Đổi từ navigateTo thành switchPage để hiện trang detail lên
    navigateTo('detail'); 
    
    const loading = document.getElementById('detail-loading');
    const body = document.getElementById('detail-body');
    
    if (loading) loading.style.display = 'flex';
    if (body) body.style.display = 'none';

    try {
        const res = await apiFetch(`/api/products/${id}`);
        const p = res.data;
        state.currentProduct = p;

        // Đổ dữ liệu vào giao diện
        const cat = state.categories.find(c => c.id === p.categoryId);
        document.getElementById('bc-category').textContent = cat ? cat.name : 'Danh mục';
        document.getElementById('bc-product-name').textContent = p.name;
        document.getElementById('detail-img').src = imgSrc(p.imageUrl);
        document.getElementById('detail-img').alt = p.name;
        
        const detCatTag = document.getElementById('detail-cat-tag');
        if(detCatTag) detCatTag.textContent = cat ? cat.name : 'Sản phẩm';
        
        const detName = document.getElementById('detail-name');
        if(detName) detName.textContent = p.name;
        
        document.getElementById('detail-price').textContent = fmtVND(p.price);

        // Xử lý Stock (Tồn kho)
        const badge = document.getElementById('detail-stock-badge');
        if (badge) {
            if (p.stockQuantity > 0) {
                badge.textContent = '✓ Còn hàng';
                badge.style.background = '#d1fae5'; badge.style.color = '#065f46';
            } else {
                badge.textContent = '✗ Hết hàng';
                badge.style.background = '#fee2e2'; badge.style.color = '#991b1b';
            }
        }

        const dot = document.getElementById('stock-dot');
        const stxt = document.getElementById('detail-stock-text');
        if (p.stockQuantity > 0) {
            if(dot) dot.className = 'stock-dot in-stock';
            if(stxt) stxt.textContent = `Còn ${p.stockQuantity} sản phẩm`;
        } else {
            if(dot) dot.className = 'stock-dot out-stock';
            if(stxt) stxt.textContent = 'Tạm hết hàng';
        }

        const qtyInput = document.getElementById('qty-input');
        if(qtyInput) {
            qtyInput.max = p.stockQuantity;
            qtyInput.value = 1;
        }
        
        document.getElementById('detail-desc').textContent = p.description || 'Chưa có mô tả.';
        document.getElementById('meta-id').textContent = `#${p.id}`;
        
        const metaCat = document.getElementById('meta-cat');
        if(metaCat) metaCat.textContent = cat ? cat.name : '—';
        
        document.getElementById('meta-stock').textContent = `${p.stockQuantity} sản phẩm`;
        document.getElementById('btn-add-cart').disabled = p.stockQuantity === 0;

        // Cập nhật gợi ý giá và Yêu thích
        updatePricingHint(p.price, 1);
        
        // Đảm bảo load lại danh sách yêu thích mới nhất từ Server
        await loadFavourites(); 
        
        // Cập nhật trạng thái nút Tim (Đỏ hoặc Trắng)
        if (typeof updateFavBtn === 'function') {
            updateFavBtn(p.id);
        }

        loadRelatedProducts(p.categoryId, p.id);

        if (loading) loading.style.display = 'none';
        if (body) body.style.display = 'grid'; // Hiện lại nội dung dạng grid
        
    } catch (err) {
        console.error("Lỗi detail:", err);
        if (loading) loading.style.display = 'none';
        // Nếu lỗi nặng quá thì mới về home
        showToast("Không thể tải chi tiết sản phẩm", "error");
    }
}

  function changeQty(delta) {
    const input = document.getElementById('qty-input');
    const max   = parseInt(input.max) || 999;
    let val = Math.max(1, Math.min(max, parseInt(input.value) + delta));
    input.value = val;
    if (state.currentProduct) updatePricingHint(state.currentProduct.price, val);
  }

  function clampQty() {
    const input = document.getElementById('qty-input');
    const max   = parseInt(input.max) || 999;
    let val = Math.max(1, Math.min(max, parseInt(input.value) || 1));
    input.value = val;
    if (state.currentProduct) updatePricingHint(state.currentProduct.price, val);
  }

  function updatePricingHint(basePrice, qty) {
    const hint = document.getElementById('pricing-hint');
    if (!hint) return;
    if (qty >= 10) {
      hint.style.display = 'block';
      hint.innerHTML = `💡 Mua từ 10 sản phẩm: giảm <strong>10%</strong> → còn <strong>${fmtVND(Math.round(basePrice * 0.9))}</strong>/sản phẩm`;
    } else if (qty >= 5) {
      hint.style.display = 'block';
      hint.innerHTML = `💡 Mua từ 10 sản phẩm để nhận giảm giá <strong>10%</strong>`;
    } else {
      hint.style.display = 'none';
    }
  }

  async function detailAddToCart() {
    if (!requireAuth('thêm vào giỏ hàng')) return;
    const p   = state.currentProduct;
    const qty = parseInt(document.getElementById('qty-input').value) || 1;
    if (!p) return;
    const btn = document.getElementById('btn-add-cart');
    btn.disabled = true; btn.textContent = 'ĐANG THÊM...';
    try {
      await apiFetchAuth('/api/cart', { method: 'POST', body: JSON.stringify({ productId: p.id, quantity: qty }) });
      showToast(`Đã thêm ${qty} sản phẩm vào giỏ hàng ✓`, 'success');
      await refreshCartCount();
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false; btn.textContent = 'THÊM VÀO GIỎ HÀNG';
    }
  }

  function detailBuyNow() {
    if (!requireAuth('mua ngay')) return;
    detailAddToCart().then(() => setTimeout(() => navigateTo('cart'), 400));
  }

  async function loadRelatedProducts(categoryId, excludeId) {
    const container = document.getElementById('related-products');
    if (!container) return;
    try {
      const res = await apiFetch(`/api/products/category/${categoryId}`);
      const prods = (Array.isArray(res.data) ? res.data : (res.data?.items || []))
        .filter(p => p.id !== excludeId).slice(0, 4);
      container.innerHTML = prods.map(p => renderProductCard(p)).join('');
    } catch { container.innerHTML = ''; }
  }

  // ════════════════════════════════════════════════════════
  //  FAVOURITES
  // ════════════════════════════════════════════════════════
  // Thay đổi URL cho đúng với Swagger: /api/FavouriteProducts
const FAV_API_URL = '/api/FavouriteProducts';

async function loadFavourites() {
    const token = localStorage.getItem('token');
    if (!token) return;
    try {
        const res = await apiFetchAuth('/api/FavouriteProducts', { method: 'GET' });
        const data = res.data || res;
        
        // Lưu mảng ID (Map lại để chắc chắn lấy đúng productId từ Swagger)
        state.favourites = (Array.isArray(data) ? data : []).map(f => f.productId || f.id || f);
        
        // Cập nhật con số trên Header ngay
        if (typeof updateFavBadge === 'function') updateFavBadge();
        
        console.log("Đã tải danh sách ID yêu thích:", state.favourites);
    } catch (err) {
        console.error("Lỗi tải Favourites:", err);
    }
}

async function toggleFavourite() {
    if (!requireAuth('thêm vào yêu thích')) return;
    const p = state.currentProduct;
    if (!p) return;

    const isFav = state.favourites.includes(p.id);
    try {
        if (isFav) {
            // DELETE /api/FavouriteProducts/{productId}
            await apiFetchAuth(`${FAV_API_URL}/${p.id}`, { method: 'DELETE' });
            state.favourites = state.favourites.filter(id => id !== p.id);
            showToast('Đã xóa khỏi yêu thích', 'info');
        } else {
            // POST /api/FavouriteProducts với body { productId: ... }
            await apiFetchAuth(FAV_API_URL, { 
                method: 'POST', 
                body: JSON.stringify({ productId: p.id }) 
            });
            state.favourites.push(p.id);
            showToast('Đã thêm vào yêu thích ❤', 'success');
        }
        updateFavBtn(p.id);
    } catch (err) {
        showToast(err.message || 'Thao tác thất bại', 'error');
    }
}
function updateFavBadge() {
    const badge = document.getElementById('fav-badge'); // ID của badge trên Header
    if (badge) {
        const count = state.favourites.length;
        badge.innerText = count;
        badge.style.display = count > 0 ? 'flex' : 'none';
    }
}

// Gọi updateFavBadge() bên trong cuối hàm loadFavourites và toggleFavourite

