@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Adidas Vietnam Official | Nâng Tầm Phong Cách</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,300;0,400;0,700;1,700;1,900&display=swap" rel="stylesheet">
<style>
    /* ============ ADIDAS PROFESSIONAL DESIGN SYSTEM ============ */
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-100: #f5f5f5;
        --gray-200: #ebedee;
        --gray-300: #767677;
        --danger: #d9393f;
        --success: #008a00;
        --font: 'Roboto Condensed', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--font); background: var(--white); color: var(--black); line-height: 1.5; text-transform: uppercase; }

    .container { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

    /* ============ BUTTONS ============ */
    .btn-adi {
        display: inline-flex; align-items: center; justify-content: space-between;
        padding: 0 20px; height: 50px; min-width: 200px;
        background: var(--black); color: var(--white);
        font-weight: 700; font-size: 13px; letter-spacing: 2px;
        border: 1px solid var(--black); cursor: pointer; transition: 0.2s;
    }
    .btn-adi::after { content: '→'; font-size: 18px; margin-left: 15px; transition: 0.3s; }
    .btn-adi:hover { background: #333; }
    .btn-adi:hover::after { transform: translateX(5px); }
    .btn-adi:disabled { background: var(--gray-300); border-color: var(--gray-300); cursor: not-allowed; }
    
    .btn-white { background: var(--white); color: var(--black); }
    .btn-ghost { background: transparent; border: none; font-weight: 700; cursor: pointer; text-transform: uppercase; }

    /* ============ NAVBAR ============ */
    header { position: sticky; top: 0; z-index: 1000; background: #fff; border-bottom: 1px solid var(--gray-200); }
    .top-strip { background: var(--black); color: #fff; font-size: 11px; text-align: center; padding: 8px 0; font-weight: 700; }
    .nav-content { height: 80px; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 42px; font-weight: 900; letter-spacing: -3px; cursor: pointer; }
    
    .nav-links { display: flex; gap: 30px; font-weight: 700; font-size: 14px; }
    .nav-links span { cursor: pointer; padding: 5px 0; border-bottom: 2px solid transparent; }
    .nav-links span:hover { border-bottom-color: var(--black); }

    .nav-btn { background: none; border: none; font-weight: 700; cursor: pointer; font-size: 14px; position: relative; text-transform: uppercase; font-family: var(--font); }
    .cart-badge { position: absolute; top: -8px; right: -12px; background: #0071ae; color: #fff; font-size: 10px; padding: 2px 6px; font-weight: 900; }

    /* ============ PRODUCT GRID ============ */
    .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
    .product-card { cursor: pointer; transition: 0.2s; border: 1px solid transparent; }
    .product-card:hover { border-color: var(--gray-200); }
    .img-wrap { aspect-ratio: 1/1; background: var(--gray-100); overflow: hidden; position: relative; }
    .img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: 0.4s; }
    .product-card:hover .img-wrap img { transform: scale(1.05); }
    .p-price {font-size: 14px;font-weight: 400; /* Adidas thường để giá font mảnh hơn tên một chút hoặc bằng */white-space: nowrap; /* Không cho giá nhảy xuống dòng */text-align: right;}
    .p-info { padding: 12px 5px; }
    .p-name { font-size: 14px; text-transform: none; font-weight: 400; height: 40px; overflow: hidden; margin: 5px 0; }
    .p-cat { color: var(--gray-300); font-size: 12px; }
    .p-stock { font-size: 12px; color: var(--gray-300); margin-bottom: 10px; }

    /* ============ LAYOUTS ============ */
    .page { display: none; min-height: 100vh; padding-bottom: 100px; }
    .page.active { display: block; animation: fadeIn 0.4s ease; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .cat-layout { display: grid; grid-template-columns: 260px 1fr; gap: 40px; margin-top: 30px; }
    .sidebar-cat-item { padding: 12px 0; border-bottom: 1px solid var(--gray-100); cursor: pointer; font-size: 14px; transition: 0.2s; }
    .sidebar-cat-item:hover { font-weight: 700; padding-left: 5px; }

    .detail-layout { display: grid; grid-template-columns: 1fr 450px; /* Cột trái cho ảnh, cột phải 450px cho info */gap: 60px; margin-top: 40px; align-items: start;}
    .gallery-grid {  display: block; /* Chuyển về block để chỉ chứa 1 ảnh */width: 100%; position: sticky; top: 120px; /* Giữ ảnh cố định khi cuộn trang */}
    .gallery-grid img { width: 100%; height: auto; object-fit: contain; background: var(--gray-100); display: block;}
    .detail-sidebar { position: sticky; top: 120px; height: fit-content; }
    .stock-badge { display: inline-block; padding: 4px 12px; font-size: 12px; font-weight: 700; margin-bottom: 10px; }
    .stock-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .stock-dot.in-stock { background: var(--success); }
    .stock-dot.out-stock { background: var(--danger); }

    /* ============ CART & CHECKOUT ============ */
    .split-layout { display: grid; grid-template-columns: 1fr 400px; gap: 40px; }
    .summary-box { background: #fff; border: 1px solid var(--gray-200); padding: 30px; position: sticky; top: 120px; }
    .cart-item { display: flex; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--gray-200); }
    .cart-item-img { width: 120px; height: 120px; object-fit: cover; background: var(--gray-100); }
    .cart-item-info { flex: 1; }
    .cart-item-name { font-size: 14px; font-weight: 700; margin-bottom: 10px; }
    .cart-qty-control { display: flex; border: 1px solid var(--black); width: fit-content; }
    .cart-qty-btn { background: none; border: none; width: 30px; height: 30px; cursor: pointer; font-weight: 700; }
    .cart-qty-val { width: 40px; text-align: center; line-height: 30px; font-weight: 700; }
    
    .co-input { width: 100%; padding: 15px; border: 1px solid var(--black); margin-bottom: 5px; font-family: inherit; }
    .co-input.error { border-color: var(--danger); }
    .co-error { color: var(--danger); font-size: 12px; display: none; margin-bottom: 15px; }
    .co-error.show { display: block; }
    .co-step { display: none; }
    .co-step.active { display: block; }

    /* Utilities */
    .loading-overlay { display: none; justify-content: center; padding: 100px 0; width: 100%; }
    .spinner { width: 40px; height: 40px; border: 4px solid var(--gray-200); border-top-color: #000; border-radius: 50%; animation: spin 1s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    #toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 9999; }
    .toast { background: #333; color: #fff; padding: 15px 25px; margin-top: 10px; font-size: 13px; font-weight: 700; border-left: 5px solid var(--success); }
    .toast.error { border-left-color: var(--danger); }

    .remove-fav-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: white;
    border: none;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-weight: bold;
    z-index: 10;
    transition: 0.2s;
}

.remove-fav-btn:hover {
    background: #000;
    color: #fff;
}

/* Đảm bảo trang Favourites dùng đúng Grid của Home */
#page-favourites .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

@@media (max-width: 1024px) {
    #page-favourites .product-grid { grid-template-columns: repeat(2, 1fr); }
}

.badge {
    position: absolute;
    top: -5px;
    right: -10px;
    background: #000; /* Màu đen chuẩn Adidas */
    color: #fff;
    font-size: 10px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}
</style>
</head>
<body>

<div id="toast-container"></div>

<header>
    <div class="top-strip">MIỄN PHÍ VẬN CHUYỂN CHO CÁC ĐƠN HÀNG TỪ 1.600.000 VNĐ</div>
    <div class="container nav-content">
        <div class="logo" onclick="navigateTo('home')" style="cursor:pointer">ADIDAS</div>
        
        <nav class="nav-links">
            <span onclick="navigateToCategory(1)">NAM</span>
            <span onclick="navigateToCategory(2)">NỮ</span>
            <span onclick="navigateToCategory(3)">TRẺ EM</span>
        </nav>

        <div style="display:flex; gap:20px; align-items:center;">
            <div style="background: var(--gray-100); padding: 5px 15px; display:flex;">
                <input type="text" id="search-input" placeholder="TÌM KIẾM" style="border:none; background:none; outline:none; font-family:inherit;">
                <span onclick="doSearch()" style="cursor:pointer">🔍</span>
            </div>
            <div id="nav-actions" style="display:flex; gap:15px; align-items:center;"></div>
        </div>

        <div class="header-icons">
            <div class="icon-item" onclick="navigateTo('favourites')" style="position: relative; cursor: pointer;">
                <span style="font-size: 24px;">♡</span>
                <span id="fav-badge" class="badge" style="position: absolute; top: -5px; right: -10px; background: black; color: white; border-radius: 50%; padding: 2px 6px; font-size: 10px; display: none;">0</span>
            </div>
        </div>
    </div>
</header>

<section id="page-home" class="page active">
    <div style="height: 600px; background: #eee; position: relative; display: flex; align-items: center; overflow: hidden;">
        <img src="https://preview.thenewsmarket.com/Previews/ADID/StillAssets/1920x1080/668891_v2.jpg" style="position:absolute; width:100%; height:100%; object-fit:cover;">
        <div class="container" style="position:relative; z-index:2; color:#fff;">
            <h1 style="font-size: 80px; font-weight: 900; font-style: italic; line-height: 0.8; margin-bottom: 20px;">CHỈ CÓ THỂ <br> LÀ ADIDAS</h1>
            <button class="btn-adi btn-white" onclick="navigateTo('category')">MUA NGAY</button>
        </div>
    </div>
    <div class="container" style="margin-top: 60px;">
        <h2 style="font-size: 32px; font-weight: 900; font-style: italic; margin-bottom: 30px;">SẢN PHẨM MỚI NHẤT</h2>
        <div id="home-products-loading" class="loading-overlay"><div class="spinner"></div></div>
        <div id="home-products" class="product-grid"></div>
        
        <h2 style="font-size: 32px; font-weight: 900; font-style: italic; margin: 60px 0 30px;">KHÁM PHÁ DANH MỤC</h2>
        <div id="home-categories" class="product-grid"></div>
    </div>
</section>

<section id="page-category" class="page">
    <div class="container" style="padding-top: 40px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid #eee; padding-bottom: 20px;">
            <div>
                <h1 id="cat-title" style="font-size: 48px; font-weight: 900; font-style: italic;">DANH MỤC</h1>
                <p id="cat-count" style="color: var(--gray-300); font-weight: 700; font-size: 13px;"></p>
            </div>
            <div class="products-sort">
                <select onchange="sortProducts(this.value)" style="padding: 10px; border: 1px solid #000; font-family: inherit; font-weight: 700;">
                    <option value="newest">MỚI NHẤT</option>
                    <option value="price-asc">GIÁ THẤP ĐẾN CAO</option>
                    <option value="price-desc">GIÁ CAO ĐẾN THẤP</option>
                </select>
            </div>
        </div>
        <div class="cat-layout">
            <aside>
                <h3 style="font-size: 14px; font-weight: 900; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px;">BỘ LỌC</h3>
                <div id="side-categories"></div>
            </aside>
            <main id="cat-products" class="product-grid"></main>
        </div>
    </div>
</section>

<section id="page-detail" class="page">
    <div class="container">
        <div id="detail-loading" class="loading-overlay"><div class="spinner"></div></div>
        <div id="detail-body" class="detail-layout">
            <div class="gallery-grid">
                <img id="detail-img" src="" alt="">
            </div>
            <div class="detail-sidebar">
                <p id="bc-category" style="color: var(--gray-300); font-weight: 700; font-size: 12px; margin-bottom: 5px;"></p>
                <h1 id="bc-product-name"></h1>
                <div id="detail-price" style="font-size: 24px; font-weight: 700; margin-bottom: 20px;"></div>
                
                <div id="detail-stock-badge" class="stock-badge"></div>
                
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px; font-size: 13px;">
                    <span id="stock-dot" class="stock-dot"></span>
                    <span id="detail-stock-text" style="font-weight: 700;"></span>
                </div>

                <div style="display:none;"><span id="detail-cat-tag"></span><span id="detail-name"></span></div>

                <div style="border-top: 1px solid #eee; padding-top: 25px;">
                    <label style="display:block; font-weight:900; font-size:12px; margin-bottom:10px;">CHỌN SỐ LƯỢNG</label>
                    <div style="display:flex; gap:10px; margin-bottom:10px;">
                        <input type="number" id="qty-input" value="1" min="1" onchange="clampQty()" 
                               style="width: 80px; height: 50px; border: 1px solid #000; text-align: center; font-weight: 700;">
                        <button id="btn-add-cart" class="btn-adi" style="flex:1;" onclick="detailAddToCart()">THÊM VÀO GIỎ HÀNG</button>
                    </div>
                    <div id="pricing-hint" style="display:none; color: var(--success); font-weight:700; margin-bottom: 20px; font-size: 13px;"></div>
                    <button class="btn-adi btn-white" style="width:100%;" onclick="toggleFavourite()">YÊU THÍCH <span id="fav-btn">♡</span></button>
                </div>

                <div id="detail-desc" style="margin-top: 40px; font-size: 14px; text-transform: none; color: #444; border-top: 1px solid #eee; padding-top: 20px;"></div>
                
                <div style="margin-top: 30px; font-size: 12px; color: var(--gray-300);">
                    <p>MÃ SP: <span id="meta-id"></span></p>
                    <p>DANH MỤC: <span id="meta-cat"></span></p>
                    <p>KHO: <span id="meta-stock"></span></p>
                </div>
            </div>
        </div>
        <h2 style="font-size: 32px; font-weight: 900; font-style: italic; margin: 60px 0 30px;">CÓ THỂ BẠN SẼ THÍCH</h2>
        <div id="related-products" class="product-grid"></div>
    </div>
</section>

<section id="page-cart" class="page">
    <div class="container" style="padding-top: 40px;">
        <h1 style="font-size: 40px; font-weight: 900; font-style: italic; margin-bottom: 40px;">GIỎ HÀNG (<span id="sum-item-count">0</span>)</h1>
        <div id="cart-loading" class="loading-overlay"><div class="spinner"></div></div>
        <div id="cart-body" style="display:none;">
            <div id="cart-empty" style="text-align:center; padding: 60px 0;">
                <h3 style="font-size: 24px; margin-bottom: 20px;">GIỎ HÀNG CỦA BẠN ĐANG TRỐNG</h3>
                <button class="btn-adi" onclick="navigateTo('home')">TIẾP TỤC MUA SẮM</button>
            </div>
            <div class="split-layout">
                <div>
                    <div id="cart-items-list"></div>
                    <div id="cart-clear-row" style="margin-top:20px; text-align:right;">
                        <button class="btn-ghost" onclick="clearCart()" style="color:var(--danger);">✕ XÓA TOÀN BỘ</button>
                    </div>
                </div>
                <div id="cart-summary-col" class="summary-box">
                    <h3 style="font-size: 20px; font-weight: 900; margin-bottom: 20px;">TỔNG KẾT ĐƠN HÀNG</h3>
                    <div style="display:flex; justify-content:space-between; margin-bottom: 10px;">
                        <span>TẠM TÍNH</span><strong id="sum-subtotal">0 ₫</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; margin-bottom: 20px; border-bottom: 1px solid var(--black); padding-bottom: 20px;">
                        <span>VẬN CHUYỂN</span><strong>MIỄN PHÍ</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size: 18px; font-weight: 900; margin-bottom: 30px;">
                        <span>TỔNG CỘNG</span><span id="sum-total">0 ₫</span>
                    </div>
                    
                    <div class="discount-box" style="margin-top: 20px;">
                        <label for="discount-input" style="font-weight: 700; display: block; margin-bottom: 10px;">CHỌN MÃ GIẢM GIÁ</label>
                        <div style="display: flex; gap: 10px;">
                            <select id="discount-input" onchange="document.getElementById('discount-result').style.display='none'" 
                                    style="flex: 1; padding: 10px; border: 1px solid #000; font-family: inherit; cursor: pointer;">
                                <option value="">-- Đang tải mã giảm giá... --</option>
                            </select>
                            <button id="btn-apply-discount" onclick="applyDiscount()" class="btn-adidas" style="padding: 10px 20px;">ÁP DỤNG</button>
                        </div>
                        <div id="discount-result" style="display: none; margin-top: 10px; font-size: 14px; padding: 8px; background: #f8f8f8;"></div>
                    </div>

                    <button class="btn-adi" style="width:100%;" onclick="goToCheckout()">THANH TOÁN</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="page-checkout" class="page">
    <div class="container" style="padding-top: 40px;">
        <h1 style="font-size: 40px; font-weight: 900; font-style: italic; margin-bottom: 40px;">THANH TOÁN</h1>
        <div class="split-layout">
            <div>
                <div style="display:flex; gap:10px; margin-bottom:30px; font-weight:900;">
                    <span id="step-1-ind" class="active">1. THÔNG TIN</span>
                    <span id="step-2-ind">2. THANH TOÁN</span>
                    <span id="step-3-ind">3. XÁC NHẬN</span>
                </div>

                <div id="co-step-1" class="co-step active">
                    <h3 style="margin-bottom:20px;">ĐỊA CHỈ GIAO HÀNG</h3>
                    <input type="text" id="co-receiver-name" class="co-input" placeholder="HỌ VÀ TÊN NGƯỜI NHẬN *">
                    <div id="err-receiver" class="co-error">Vui lòng nhập tên người nhận.</div>
                    
                    <input type="text" id="co-phone" class="co-input" placeholder="SỐ ĐIỆN THOẠI *">
                    <div id="err-phone" class="co-error">Số điện thoại không hợp lệ.</div>

                    <input type="text" id="co-province" class="co-input" placeholder="TỈNH / THÀNH PHỐ">
                    <input type="text" id="co-shipping-addr" class="co-input" placeholder="ĐỊA CHỈ CHI TIẾT (SỐ NHÀ, ĐƯỜNG) *">
                    <div id="err-shipping" class="co-error">Vui lòng nhập địa chỉ giao hàng.</div>

                    <textarea id="co-note" class="co-input" placeholder="GHI CHÚ ĐƠN HÀNG (TÙY CHỌN)" rows="3"></textarea>

                    <label style="display:flex; align-items:center; gap:10px; margin: 20px 0; font-weight:700;">
                        <input type="checkbox" id="same-addr" checked onchange="toggleBillingAddr()">
                        SỬ DỤNG ĐỊA CHỈ NÀY ĐỂ XUẤT HÓA ĐƠN
                    </label>
                    <div id="billing-addr-field" style="display:none;">
                        <input type="text" id="co-billing-addr" class="co-input" placeholder="ĐỊA CHỈ XUẤT HÓA ĐƠN">
                    </div>

                    <button class="btn-adi" style="width:100%; margin-top:20px;" onclick="goToPaymentStep()">TIẾP TỤC ĐẾN PHƯƠNG THỨC THANH TOÁN</button>
                </div>

                <div id="co-step-2" class="co-step">
                    <h3 style="margin-bottom:20px;">CHỌN PHƯƠNG THỨC THANH TOÁN</h3>
                    <div id="payment-method-list" style="display:flex; flex-direction:column; gap:10px; margin-bottom: 20px;"></div>
                    
                    <div id="card-details" style="display:none; border:1px solid var(--gray-200); padding:20px; margin-bottom:20px;">
                        <input type="text" class="co-input" placeholder="SỐ THẺ" oninput="formatCardNumber(this)">
                        <div style="display:flex; gap:10px;">
                            <input type="text" class="co-input" placeholder="MM/YY" oninput="formatExpiry(this)">
                            <input type="text" class="co-input" placeholder="CVC">
                        </div>
                    </div>

                    <div style="display:flex; gap:10px;">
                        <button class="btn-adi btn-white" style="flex:1;" onclick="goToStep(1)">QUAY LẠI</button>
                        <button class="btn-adi" style="flex:2;" onclick="goToConfirmStep()">TIẾP TỤC</button>
                    </div>
                </div>

                <div id="co-step-3" class="co-step">
                    <h3 style="margin-bottom:20px;">XÁC NHẬN ĐƠN HÀNG</h3>
                    <div style="background:var(--gray-100); padding:20px; margin-bottom:20px; font-size:13px; font-weight:700; text-transform:none;">
                        <p style="margin-bottom:5px;"><strong>Giao tới:</strong> <span id="review-shipping"></span></p>
                        <p style="margin-bottom:5px;"><strong>Thanh toán bằng:</strong> <span id="review-payment"></span></p>
                        <p id="review-note-row"><strong>Ghi chú:</strong> <span id="review-note"></span></p>
                    </div>
                    <div id="review-items" style="margin-bottom:20px; font-weight:700; font-size:13px;"></div>
                    <div style="border-top:1px solid var(--black); padding-top:10px; margin-bottom:20px;">
                        <div style="display:flex; justify-content:space-between;"><span>TẠM TÍNH</span><strong id="review-subtotal"></strong></div>
                        <div id="review-discount-row" style="display:none; justify-content:space-between; color:var(--success);"><span>GIẢM GIÁ</span><strong id="review-discount"></strong></div>
                        <div style="display:flex; justify-content:space-between; font-size:18px; margin-top:10px;"><span>TỔNG CỘNG</span><strong id="review-total"></strong></div>
                    </div>

                    <label style="display:flex; align-items:flex-start; gap:10px; margin: 20px 0; font-size:12px; font-weight:700;">
                        <input type="checkbox" id="co-agree" style="margin-top:3px;">
