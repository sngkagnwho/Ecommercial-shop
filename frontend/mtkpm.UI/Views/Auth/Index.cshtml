@{
    Layout = null;
    var initialTab = ViewData["Tab"]?.ToString() ?? "login";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>adidas Official - Authentication</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,300;0,400;0,700;1,700;1,900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000; --white: #ffffff; --gray-100: #f5f5f5; --gray-200: #ebedee;
            --gray-300: #767677; --danger: #d9393f; --success: #008a00; --font-main: 'Roboto Condensed', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; text-transform: uppercase; }
        body { font-family: var(--font-main); background: var(--white); color: var(--primary); min-height: 100vh; display: flex; }
        .auth-wrapper { display: flex; width: 100%; }
        .brand-panel { flex: 1.1; background: var(--gray-100); position: relative; display: flex; flex-direction: column; justify-content: center; padding: 60px; overflow: hidden; }
        .brand-back { position: absolute; top: 40px; left: 60px; color: var(--primary); font-weight: 700; text-decoration: underline; font-size: 13px; cursor: pointer; z-index: 10; }
        .adidas-logo { width: 80px; margin-bottom: 40px; }
        .brand-headline { font-size: 64px; line-height: 0.9; font-weight: 900; font-style: italic; margin-bottom: 20px; letter-spacing: -1px; }
        .brand-sub { font-size: 16px; max-width: 450px; letter-spacing: 0.5px; }
        .form-panel { flex: 0.9; display: flex; align-items: center; justify-content: center; padding: 40px; }
        .auth-card { width: 100%; max-width: 440px; }
        .form-title { font-size: 36px; font-weight: 900; margin-bottom: 5px; }
        .form-sub { font-size: 14px; margin-bottom: 30px; letter-spacing: 1px; color: var(--gray-300); }
        .field { margin-bottom: 20px; }
        .field label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 8px; }
        .field input { width: 100%; padding: 16px; border: 1px solid var(--gray-300); border-radius: 0; font-size: 16px; font-family: var(--font-main); transition: 0.2s; }
        .field input:focus { border-color: var(--primary); outline: 1px solid var(--primary); }
        .field input.error { border-color: var(--danger); }
        .field-error { color: var(--danger); font-size: 12px; margin-top: 5px; font-weight: 700; display: none; }
        .field-error.show { display: block; }
        .btn-submit { width: 100%; padding: 18px; background: var(--primary); color: var(--white); border: 1px solid var(--primary); border-radius: 0; font-weight: 900; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; transition: 0.2s; }
        .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-submit::after { content: '→'; font-size: 20px; }
        .nav-link-wrapper { margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--gray-200); }
        .nav-link { font-weight: 700; text-decoration: underline; cursor: pointer; font-size: 14px; }
        .form-section { display: none; }
        .form-section.active { display: block; }
        .success-overlay { position: fixed; inset: 0; background: var(--white); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: 0.4s; }
        .success-overlay.show { opacity: 1; pointer-events: all; }
        @@media (max-width: 1024px) { .brand-panel { display: none; } }
    </style>
</head>
<body>

<div class="success-overlay" id="success-overlay">
    <img src="https://upload.wikimedia.org/wikipedia/commons/2/20/Adidas_Logo.svg" style="width:100px; margin-bottom: 20px;">
    <h2 id="overlay-title" style="font-size: 42px; font-weight: 900; font-style: italic;">SUCCESS</h2>
    <p id="success-msg" style="letter-spacing: 2px; margin-top: 10px;"></p>
</div>

<div class="auth-wrapper">
    <div class="brand-panel">
        <a class="brand-back" href="/">QUAY LẠI CỬA HÀNG</a>
        <div class="brand-content">
            <img src="https://upload.wikimedia.org/wikipedia/commons/2/20/Adidas_Logo.svg" class="adidas-logo">
            <h1 class="brand-headline">IMPOSSIBLE<br>IS NOTHING</h1>
            <p class="brand-sub">ĐĂNG KÝ NGAY ĐỂ TRỞ THÀNH THÀNH VIÊN ADICLUB. NHẬN ƯU ĐÃI ĐỘC QUYỀN.</p>
        </div>
    </div>

    <div class="form-panel">
        <div class="auth-card">
            <div class="form-section" id="section-login">
                <h2 class="form-title">ĐĂNG NHẬP</h2>
                <p class="form-sub">Chào mừng bạn trở lại</p>

                <div class="field">
                    <label>EMAIL / TÊN ĐĂNG NHẬP *</label>
                    <input type="text" id="login-username" placeholder="EMAIL / USERNAME">
                    <div class="field-error" id="err-login-username">VUI LÒNG NHẬP THÔNG TIN</div>
                </div>

                <div class="field">
                    <label>MẬT KHẨU *</label>
                    <input type="password" id="login-password" placeholder="••••••••">
                    <div class="field-error" id="err-login-password">VUI LÒNG NHẬP MẬT KHẨU</div>
                </div>

                <label style="display:flex; gap:10px; margin-bottom:20px; font-size:12px; font-weight:700; cursor:pointer;">
                    <input type="checkbox" id="login-remember" checked> DUY TRÌ ĐĂNG NHẬP
                </label>

                <button class="btn-submit" id="btn-login-submit"><span>ĐĂNG NHẬP</span></button>
                
                <div class="nav-link-wrapper">
                    <span>CHƯA CÓ TÀI KHOẢN? </span>
                    <span class="nav-link" id="go-to-register">ĐĂNG KÝ NGAY</span>
                </div>
            </div>

            <div class="form-section" id="section-register">
                <h2 class="form-title">TẠO TÀI KHOẢN</h2>
                <p class="form-sub">THAM GIA ADICLUB MIỄN PHÍ</p>

                <div class="field">
                    <label>TÊN ĐĂNG NHẬP *</label>
                    <input type="text" id="reg-username" placeholder="USERNAME">
                    <div class="field-error" id="err-reg-username">TỐI THIỂU 3 KÝ TỰ</div>
                </div>

                <div class="field">
                    <label>EMAIL *</label>
                    <input type="email" id="reg-email" placeholder="EMAIL@EXAMPLE.COM">
                    <div class="field-error" id="err-reg-email">EMAIL KHÔNG HỢP LỆ</div>
                </div>

                <div class="field">
                    <label>MẬT KHẨU *</label>
                    <input type="password" id="reg-password" placeholder="••••••••">
                    <div class="field-error" id="err-reg-password">TỐI THIỂU 6 KÝ TỰ</div>
                </div>

                <div class="field">
                    <label>XÁC NHẬN MẬT KHẨU *</label>
                    <input type="password" id="reg-confirm" placeholder="••••••••">
                    <div class="field-error" id="err-reg-confirm">MẬT KHẨU KHÔNG KHỚP</div>
                </div>

                <label style="display:flex; gap:10px; margin-bottom:5px; font-size:12px; font-weight:700; cursor:pointer;">
                    <input type="checkbox" id="reg-terms"> TÔI CHẤP NHẬN ĐIỀU KHOẢN
                </label>
                <div class="field-error" id="err-reg-terms" style="margin-bottom:15px">BẠN CẦN ĐỒNG Ý VỚI ĐIỀU KHOẢN</div>

                <button class="btn-submit" id="btn-register-submit"><span>ĐĂNG KÝ</span></button>

                <div class="nav-link-wrapper">
                    <span>ĐÃ CÓ TÀI KHOẢN? </span>
                    <span class="nav-link" id="go-to-login">ĐĂNG NHẬP TẠI ĐÂY</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const API_BASE_URL = 'https://localhost:5107';
    let isSubmitting = false;

    // --- Helpers ---
    const v = (id) => document.getElementById(id).value;
    const showErr = (id, msg = null) => {
        const input = document.getElementById(id);
        const errDiv = document.getElementById(`err-${id}`);
        if(input) input.classList.add('error');
        if(errDiv) {
            if(msg) errDiv.innerText = msg;
            errDiv.classList.add('show');
        }
    };
    const clearErrors = () => {
        document.querySelectorAll('.field input').forEach(i => i.classList.remove('error'));
        document.querySelectorAll('.field-error').forEach(e => e.classList.remove('show'));
    };

    // --- UI Logic ---
    function switchForm(target) {
        clearErrors();
        document.querySelectorAll('.form-section').forEach(s => s.classList.remove('active'));
        document.getElementById(`section-${target}`).classList.add('active');
    }

    function showOverlay(title, msg, duration = 2000) {
        const overlay = document.getElementById('success-overlay');
        document.getElementById('overlay-title').innerText = title;
        document.getElementById('success-msg').innerText = msg;
        overlay.classList.add('show');
        return new Promise(resolve => setTimeout(() => {
            overlay.classList.remove('show');
            resolve();
        }, duration));
    }

    // --- Actions ---
    async function handleLogin() {
    if (isSubmitting) return;
    clearErrors();
    
    const username = v('login-username').trim();
    const password = v('login-password');
    
    // Kiểm tra nhanh phía Client
    if (!username) return showErr('login-username', "VUI LÒNG NHẬP TÊN ĐĂNG NHẬP");
    if (!password) return showErr('login-password', "VUI LÒNG NHẬP MẬT KHẨU");

    isSubmitting = true;
    try {
        const res = await fetch(`${API_BASE_URL}/api/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                userNameOrEmail: username, 
                password, 
                rememberMe: document.getElementById('login-remember').checked 
            })
        });
        
        const result = await res.json();

        // XỬ LÝ THEO JSON MỚI: success là true và có accessToken
        if (result.success === true && result.accessToken) {
            // Lưu Token
            localStorage.setItem('token', result.accessToken);
            localStorage.setItem('refreshToken', result.refreshToken);
            localStorage.setItem('user', JSON.stringify(result.user));

            // Hiển thị thông báo thành công
            await showOverlay("XÁC THỰC", `CHÀO MỪNG ${result.user.userName.toUpperCase()}`, 1200);
            
            // Chuyển hướng
            window.location.href = '/Home'; 
        } else {
            // XỬ LÝ KHI THẤT BẠI: Lấy lỗi từ result.message hoặc mảng result.errors
            let errorMsg = result.message || "ĐĂNG NHẬP THẤT BẠI";
            if (result.errors && result.errors.length > 0) {
                errorMsg = result.errors[0]; // Lấy lỗi đầu tiên trong mảng
            }
            
            alert(errorMsg); // Hoặc dùng toast/thẻ div để hiện lỗi đẹp hơn
        }
    } catch (err) {
        console.error("Fetch Error:", err);
        alert("KHÔNG THỂ KẾT NỐI ĐẾN MÁY CHỦ");
    } finally { 
        isSubmitting = false; 
    }
}

    async function handleRegister() {
        if (isSubmitting) return;
        clearErrors();

        const user = v('reg-username').trim();
        const email = v('reg-email').trim();
        const pass = v('reg-password');
        const confirm = v('reg-confirm');
        const terms = document.getElementById('reg-terms').checked;

        let ok = true;
        if (user.length < 3) { showErr('reg-username'); ok = false; }
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) { showErr('reg-email'); ok = false; }
        if (pass.length < 6) { showErr('reg-password'); ok = false; }
        if (pass !== confirm) { showErr('reg-confirm'); ok = false; }
        if (!terms) { showErr('reg-terms'); ok = false; }

        if (!ok) return;

        isSubmitting = true;
        try {
            const res = await fetch(`${API_BASE_URL}/api/auth/register`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userName: user, email, password: pass, confirmPassword: confirm })
            });
            
            const result = await res.json();
            if (!res.ok) throw new Error(result.message || 'Đăng ký thất bại');

            if (result.success) {
                await showOverlay("THÀNH CÔNG", "TÀI KHOẢN ĐÃ SẴN SÀNG. VUI LÒNG ĐĂNG NHẬP.");
                switchForm('login');
                // Reset form
                ['reg-username', 'reg-email', 'reg-password', 'reg-confirm'].forEach(id => {
                    document.getElementById(id).value = '';
                });
                document.getElementById('reg-terms').checked = false;
            }
        } catch (err) {
            alert(err.message);
        } finally { isSubmitting = false; }
    }

    // --- Init ---
    document.addEventListener('DOMContentLoaded', () => {
        const initTab = '@initialTab';
        switchForm(initTab === 'register' ? 'register' : 'login');

        document.getElementById('go-to-register').onclick = () => switchForm('register');
        document.getElementById('go-to-login').onclick = () => switchForm('login');
        
        document.getElementById('btn-login-submit').onclick = handleLogin;
        document.getElementById('btn-register-submit').onclick = handleRegister;

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const isLogin = document.getElementById('section-login').classList.contains('active');
                if (isLogin) handleLogin(); else handleRegister();
            }
        });
    });
</script>
</body>
</html>